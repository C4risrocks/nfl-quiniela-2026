# NFL Quiniela 2026 Configuration

# Server Port
PORT=8080

# Database Configuration
# Options for DB_TYPE: 'sqlite' or 'postgres'
DB_TYPE=sqlite
DB_PATH=quiniela.db

# For PostgreSQL migration:
# DB_TYPE=postgres
# DATABASE_URL=postgres://username:password@localhost:5432/quiniela_db?sslmode=disable

# Session Security
SESSION_SECRET=change-this-to-a-random-32-byte-secret-key-in-production

# Default Administrator Credentials (Created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quiniela.com

# ESPN Synchronization
ESPN_SYNC_INTERVAL_MINS=5
ENABLE_BACKGROUND_SYNC=true
CURRENT_SEASON_YEAR=2026
