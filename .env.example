# ==============================================================================
# NFL Quiniela 2026 - Configuración de Variables de Entorno
# Copia este archivo a .env para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# Puerto local del servidor HTTP
PORT=8080

# Base de datos local (SQLite)
DB_TYPE=sqlite
DB_PATH=quiniela.db

# Secreto de sesión (Cadena segura de 32+ caracteres)
SESSION_SECRET=super-secreto-cambiar-en-produccion-2026-quiniela

# Credenciales del Administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quiniela.local

# Sincronización automática de resultados y marcadores desde ESPN
ENABLE_BACKGROUND_SYNC=true
ESPN_SYNC_INTERVAL_MINS=5
CURRENT_SEASON_YEAR=2026

# URL base de la aplicación (Usada para los enlaces en los correos de recordatorio)
# En desarrollo: http://localhost:8080
# En producción: https://quiniela.tudominio.com
APP_BASE_URL=http://localhost:8080

# ==============================================================================
# Notificaciones y Recordatorios por Correo (SMTP)
# ==============================================================================
# Si ENABLE_REMINDERS=false o SMTP_HOST está vacío, el sistema funciona en modo
# MOCK (imprime el contenido de los correos en la consola para depuración sin enviar nada).
ENABLE_REMINDERS=true

# Opción A: Configuración con Gmail (Recomendado para desarrollo)
# Requiere generar una "Contraseña de Aplicación" (Token de 16 letras) en Google:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=tu-correo@gmail.com

# Opción B: Configuración con Resend (Recomendado para producción)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_tu_api_key_aqui
# SMTP_FROM=quiniela@tudominio.com
