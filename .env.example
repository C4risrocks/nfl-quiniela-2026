# ==============================================================================
# NFL Quiniela 2026 - Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# Copia este archivo como '.env' para desarrollo local o copia las variables
# en la pestaña 'Environment Variables' de tu panel Dokploy.

# --- Servidor Web ---
PORT=8080
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=super-secret-session-key-change-in-prod-2026

# --- Base de Datos (SQLite por defecto / PostgreSQL opcional) ---
DB_TYPE=sqlite
DB_PATH=quiniela.db
# DATABASE_URL=postgres://usuario:password@localhost:5432/quiniela?sslmode=disable

# --- Cuenta de Administrador Inicial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quiniela.com

# --- Sincronización en Vivo ESPN ---
CURRENT_SEASON_YEAR=2026
ENABLE_BACKGROUND_SYNC=true
ESPN_SYNC_INTERVAL_MINS=5

# --- Servicio de Correo Electrónico (Gmail SMTP) ---
# 1. Requiere verificación de 2 pasos en tu cuenta de Google.
# 2. Genera una contraseña de aplicación en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=tu_correo@gmail.com
ENABLE_REMINDERS=true

# --- Notificaciones Push Web / Celular (VAPID RFC 8292) ---
# Si se dejan vacías, la aplicación autogenerará un par de claves y las persistirá en disco (.vapid_keys.json).
# Puedes definir llaves fijas para producción:
# VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa...
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx...
# VAPID_SUBJECT=mailto:admin@quiniela.com
