 out.push(await page.evaluate(()=>{const t=document.getElementById('toast-container');return {test:'A10-visible',role:t.getAttribute('role'),aria:t.getAttribute('aria-live'),text:t.textContent.trim(),visible:getComputedStyle(t).display!=='none'};}));
 await page.waitForTimeout(4500);
 out.push(await page.evaluate(()=>{const t=document.getElementById('toast-container');return {test:'A10-after4s',text:t.textContent.trim(),visible:getComputedStyle(t).display!=='none'};}));
