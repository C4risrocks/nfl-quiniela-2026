 await page.waitForTimeout(300);
 out.push(await page.evaluate(()=>{const d=document.querySelector('[role=dialog]');return{test:'A09-initial',role:d.getAttribute('role'),modal:d.getAttribute('aria-modal'),name:document.getElementById(d.getAttribute('aria-labelledby'))?.textContent.trim(),focusInside:d.contains(document.activeElement),active:document.activeElement.tagName};}));
 await page.keyboard.press('Tab');
