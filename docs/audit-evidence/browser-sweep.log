   }catch(e){rows.push({width,path,error:e.message.slice(0,160)});}
  }
 }
 await page.goto('http://localhost:18089/login');
 await page.locator('input[name=username]').fill('auditadmin');
 await page.locator('input[name=password]').fill('audit-temporary-password');
 await page.getByRole('button',{name:'Continuar'}).click();
 for (const width of widths) {
  await page.setViewportSize({width,height:900});
  for(const path of ['/picks','/profile','/admin','/picks/advisor','/picks/matrix']) {
   try {await page.goto('http://localhost:18089'+path,{waitUntil:'domcontentloaded',timeout:20000}); await page.waitForTimeout(100);
   rows.push(await page.evaluate(({width,path})=>({width,path,final:location.pathname,overflow:document.documentElement.scrollWidth>innerWidth,templateError:/error calling|executing "/.test(document.body.textContent),h1:document.querySelector('h1')?.textContent.trim()}),{width,path}));
   if([360,1366].includes(width))await page.screenshot({path:'/Users/christiandejmorenomarin/Documents/nfl-quiniela-2026/docs/audit-evidence/auth-'+path.slice(1).replaceAll('/','-')+'-'+width+'.png'});
   }catch(e){rows.push({width,path,error:e.message.slice(0,160)});}
  }
 }
 return rows;
}
)(page);
